{
	"nodes":[
		{"id":"group-sources","type":"group","x":0,"y":0,"width":660,"height":980,"label":"1. Разрешённые источники","color":"2"},
		{"id":"group-intake","type":"group","x":760,"y":0,"width":660,"height":980,"label":"2. Приём и границы","color":"3"},
		{"id":"group-evidence","type":"group","x":1520,"y":0,"width":660,"height":980,"label":"3. Evidence Layer","color":"5"},
		{"id":"group-review","type":"group","x":2280,"y":0,"width":660,"height":980,"label":"4. Интерпретация и контроль","color":"6"},
		{"id":"group-trust","type":"group","x":3040,"y":0,"width":660,"height":980,"label":"5. Shared Trust Core","color":"4"},
		{"id":"group-action","type":"group","x":3800,"y":0,"width":660,"height":980,"label":"6. Действие и проверка","color":"3"},
		{"id":"group-security","type":"group","x":0,"y":1100,"width":4460,"height":520,"label":"Сквозная граница безопасности и доверия","color":"1"},
		{"id":"source-import","type":"text","x":60,"y":90,"width":540,"height":170,"text":"# CSV / XLSX\n\nПервый реализованный ingestion path. Пользователь загружает объекты и риски с preview, validation и metadata источника.","color":"4"},
		{"id":"source-connectors","type":"text","x":60,"y":320,"width":540,"height":190,"text":"# Connectors\n\nПланируемые adapter-based интеграции. Источник выбирается только после подтверждённого спроса и admission decision.","color":"6"},
		{"id":"source-collectors","type":"text","x":60,"y":570,"width":540,"height":190,"text":"# Paired Collectors\n\nБудущий ограниченный локальный сбор для Home/Business. Только подтверждённый scope, least privilege и allowlisted observations.","color":"6"},
		{"id":"source-rule","type":"text","x":60,"y":820,"width":540,"height":100,"text":"**Запрещено:** прямое письмо источника в Objects, Risks, Trust Score или Graph.","color":"1"},
		{"id":"intake-adapter","type":"text","x":820,"y":90,"width":540,"height":180,"text":"# Adapter / Intake\n\nПринимает bounded payload, проверяет формат, размер, источник и безопасные классы ошибок.","color":"3"},
		{"id":"intake-scope","type":"text","x":820,"y":330,"width":540,"height":210,"text":"# Consent & Scope Gate\n\n- authenticated membership;\n- разрешённая цель;\n- подтверждённый target scope;\n- audit event;\n- лимиты и срок действия.","color":"1"},
		{"id":"intake-quarantine","type":"text","x":820,"y":600,"width":540,"height":180,"text":"# Raw Payload Boundary\n\nНеобработанные данные изолируются до parser/normalizer. Business projections ещё не создаются.","color":"2"},
		{"id":"evidence-store","type":"text","x":1580,"y":90,"width":540,"height":210,"text":"# Evidence Store\n\nНаблюдение из источника с provenance, временем, freshness, confidence и ссылкой на scope.\n\n**Статус:** целевая модель Sprint 17.","color":"5"},
		{"id":"evidence-normalize","type":"text","x":1580,"y":360,"width":540,"height":200,"text":"# Normalization & Identity Resolution\n\nНормализация, дедупликация, сопоставление идентификаторов и выявление конфликтов без потери источника.","color":"5"},
		{"id":"evidence-findings","type":"text","x":1580,"y":620,"width":540,"height":220,"text":"# Finding Candidates\n\nНаблюдаемая проблема или условие, подтверждённое evidence. Finding не равен автоматически принятому бизнес-риску.","color":"6"},
		{"id":"review-inbox","type":"text","x":2340,"y":90,"width":540,"height":190,"text":"# Discovery Inbox\n\nЧеловек подтверждает новые объекты, исправляет ошибки определения, разрешает merge-конфликты и отклоняет шум.","color":"6"},
		{"id":"review-policy","type":"text","x":2340,"y":340,"width":540,"height":190,"text":"# Policy & Confidence\n\nАвтоматическое принятие допускается только для достаточно надёжных, объяснимых и разрешённых наблюдений.","color":"3"},
		{"id":"review-projection","type":"text","x":2340,"y":590,"width":540,"height":250,"text":"# Business Projections\n\nПосле review создаются или обновляются:\n\n- Assets / Identities;\n- typed Relations;\n- Risks или risk candidates;\n- business criticality и manual context.","color":"4"},
		{"id":"trust-passport","type":"text","x":3100,"y":90,"width":540,"height":190,"text":"# Trust Passport\n\nВерсионированная evidence-backed проекция доверия объекта или идентичности.","color":"4"},
		{"id":"trust-score","type":"text","x":3100,"y":340,"width":540,"height":190,"text":"# Trust Score\n\nОценка с факторами, coverage, freshness, confidence и объяснением. Формулы версионируются отдельно по режимам.","color":"4"},
		{"id":"trust-graph","type":"text","x":3100,"y":590,"width":540,"height":250,"text":"# Trust Graph & Impact\n\nTyped relations с provenance позволяют объяснять зависимости, exposure paths, SPOF и возможные каскадные последствия без недоказанной причинности.","color":"4"},
		{"id":"action-recommend","type":"text","x":3860,"y":90,"width":540,"height":190,"text":"# Recommendation\n\nБезопасное объяснение: что обнаружено, почему важно, что затронуто и какое действие рекомендуется.","color":"3"},
		{"id":"action-remediation","type":"text","x":3860,"y":340,"width":540,"height":190,"text":"# Remediation\n\nРешение, исполнитель, срок, статус и доказательство выполнения. Автономное исправление не входит в MVP.","color":"3"},
		{"id":"action-verify","type":"text","x":3860,"y":590,"width":540,"height":250,"text":"# Verification Evidence\n\nПовторная ограниченная проверка подтверждает результат и возвращает новое evidence в цикл доверия.","color":"5"},
		{"id":"security-boundary","type":"text","x":80,"y":1180,"width":2960,"height":340,"text":"# Security Boundary\n\n- Workspace / tenant isolation и RLS;\n- server-side authorization и input validation;\n- least privilege и отсутствие service role на клиенте;\n- audit, consent, scope, expiry и safe errors;\n- запрет arbitrary shell, произвольного scanning и чужих identifiers;\n- data minimization, retention и deletion для Home/Personal;\n- каждый connector работает через adapter/ingestion contract.","color":"1"},
		{"id":"architecture-source","type":"file","x":3140,"y":1180,"width":560,"height":150,"file":"50 — Проекты/DTEK Core/Репозиторий/docs/architecture/DTEK_PLATFORM_ARCHITECTURE.md","color":"5"},
		{"id":"security-source","type":"file","x":3780,"y":1180,"width":560,"height":150,"file":"50 — Проекты/DTEK Core/04 — Архитектура и безопасность.md","color":"1"}
	],
